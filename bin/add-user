#!/usr/bin/env python3
"""
add-user — provision a new Hermes user on the VPS.

Usage:
  bin/add-user --name "Prakash M" --email prakash@draas.com \
               --telegram-id 123456789 --phone "+91..." [--role employee]

What it does (all on the VPS via SSH):
   1. Adds telegram_id to TELEGRAM_ALLOWED_USERS in /opt/hermes/.env
   2. Adds full profile + cross_message_allowed:true to users.json
   3. Syncs identity records to the gws-vault daemon (canonical identity source)
   4. Creates the user's gbrain home directory
   5. Restarts the hermes container so the new .env takes effect

No Docker image rebuild is needed — users.json is volume-mounted and
hot-reloaded; the .env change only requires a container restart.
"""

import argparse
import json
import subprocess
import sys

VPS = "root@178.105.35.94"
ENV_FILE = "/opt/hermes/.env"
USERS_JSON = "/opt/hermes/hermes-data/users.json"
USERS_HOME_BASE = "/opt/hermes/hermes-data/users"
COMPOSE_FILE = "/opt/hermes/docker-compose.yml"
HERMES_SERVICE = "hermes"


def ssh(cmd: str, capture: bool = True) -> str:
    result = subprocess.run(
        ["ssh", VPS, cmd],
        capture_output=capture,
        text=True,
    )
    if result.returncode != 0:
        print(f"SSH error: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    return result.stdout.strip() if capture else ""


def parse_args():
    p = argparse.ArgumentParser(description="Add or update a Hermes user on the VPS")
    p.add_argument("--name", required=True, help="Full name, e.g. 'Prakash M'")
    p.add_argument("--email", required=True, help="Work email, e.g. prakash@draas.com")
    p.add_argument("--telegram-id", required=True, type=str, help="Telegram user ID (numeric)")
    p.add_argument("--phone", default="", help="Phone with country code, e.g. +919876543210")
    p.add_argument("--role", default="employee", choices=["admin", "employee"], help="User role (default: employee)")
    p.add_argument("--no-restart", action="store_true", help="Skip container restart (dry-run mode)")
    return p.parse_args()


def update_env(telegram_id: str, dry_run: bool):
    print(f"[1/4] Updating TELEGRAM_ALLOWED_USERS in {ENV_FILE}...")
    current = ssh(f"grep '^TELEGRAM_ALLOWED_USERS=' {ENV_FILE} | cut -d= -f2-")
    ids = [x.strip() for x in current.split(",") if x.strip()]
    if telegram_id in ids:
        print(f"      Already present: {telegram_id}")
        return
    ids.append(telegram_id)
    new_val = ",".join(ids)
    ssh(f"sed -i 's|^TELEGRAM_ALLOWED_USERS=.*|TELEGRAM_ALLOWED_USERS={new_val}|' {ENV_FILE}")
    print(f"      Updated: {new_val}")


def update_users_json(telegram_id: str, name: str, email: str, phone: str, role: str):
    print(f"[2/4] Updating users.json...")
    raw = ssh(f"cat {USERS_JSON}")
    data = json.loads(raw)
    entry = data.get(telegram_id, {})
    entry.update({
        "name": name,
        "email": email,
        "role": role,
        "cross_message_allowed": True,
    })
    if phone:
        entry["phone"] = phone
    entry.setdefault("gbrain_home", f"/data/hermes/users/{telegram_id}")
    data[telegram_id] = entry
    new_json = json.dumps(data, indent=2, ensure_ascii=False)
    # Write atomically via temp file
    escaped = new_json.replace("'", "'\"'\"'")
    ssh(f"printf '%s' '{escaped}' > {USERS_JSON}.tmp && mv {USERS_JSON}.tmp {USERS_JSON}")
    print(f"      Saved profile for {name} ({telegram_id})")


def sync_identity_to_vault(telegram_id: str, name: str, email: str, role: str):
    print(f"[3/5] Syncing identity to gws-vault...")
    slug = "".join(c for c in email.split("@")[0] if c.isalnum() or c in "._-") or telegram_id
    # Build a Python snippet that reads vault_secret from the env file, then calls add_identity.
    script = (
        "import os, json; "
        "env = dict(l.split('=', 1) for l in open('/etc/gws-vault.env') if '=' in l); "
        "os.environ['GWS_VAULT_SOCKET'] = env.get('GWS_VAULT_SOCKET', '/run/gws-vault/vault.sock').strip(); "
        "os.environ['GWS_VAULT_SECRET'] = env['GWS_VAULT_SECRET'].strip() if 'GWS_VAULT_SECRET' in env else ''; "
        f"import sys; sys.path.insert(0, '/opt/hermes/hermes-agent'); "
        f"from tools import gws_vault_client as v; "
        f"v.add_identity(user_id='{email}', identity_type='email', identity_value='{email}', name='{name}', role='{role}'); "
        f"v.add_identity(user_id='{email}', identity_type='telegram', identity_value='{telegram_id}'); "
        f"v.add_identity(user_id='{email}', identity_type='draas_user_id', identity_value='{slug}'); "
        f"print('Vault identity synced for {email}')"
    )
    result = ssh(f"cd /opt/hermes/hermes-agent && /usr/bin/python3 -c \"{script}\"")
    print(f"      {result}")


def create_home_dir(telegram_id: str):
    home = f"{USERS_HOME_BASE}/{telegram_id}"
    print(f"[4/5] Creating gbrain home: {home}")
    ssh(f"mkdir -p {home}")
    print(f"      Done.")


def restart_container(dry_run: bool):
    if dry_run:
        print("[5/5] Skipping restart (--no-restart)")
        return
    print(f"[5/5] Restarting {HERMES_SERVICE} container...")
    ssh(f"docker compose -f {COMPOSE_FILE} restart {HERMES_SERVICE}", capture=False)
    print("      Restarted.")


def main():
    args = parse_args()
    tid = args.telegram_id.strip()

    print(f"\nProvisioning user: {args.name} | {args.email} | Telegram {tid}\n")

    update_env(tid, args.no_restart)
    update_users_json(tid, args.name, args.email, args.phone, args.role)
    sync_identity_to_vault(tid, args.name, args.email, args.role)
    create_home_dir(tid)
    restart_container(args.no_restart)

    print(f"\nDone. {args.name} can now:")
    print(f"  • Chat with Hermes on Telegram (ID: {tid})")
    print(f"  • Send and receive Telegram messages with other allowed users")
    print(f"\nTo add Prakash or anyone else:")
    print(f"  bin/add-user --name 'Name' --email email@draas.com --telegram-id ID --phone +91...")


if __name__ == "__main__":
    main()
