# DRAFT -- initial HTTP-only vhost for jobs.ahfl.in.
#
# This is NOT the final config. It exists only so certbot's HTTP-01
# challenge has something to answer on port 80 before a cert exists.
# Once DNS for jobs.ahfl.in resolves to this box, run:
#
#   cp jobs.ahfl.in.nginx.draft /etc/nginx/sites-available/jobs.ahfl.in
#   ln -s /etc/nginx/sites-available/jobs.ahfl.in /etc/nginx/sites-enabled/jobs.ahfl.in
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d jobs.ahfl.in
#
# certbot will REWRITE this file in place to add the 443 server block +
# the http->https redirect, in the exact same shape every other
# *.ahfl.in vhost already has (verified against chat.ahfl.in,
# voice.ahfl.in -- both say "# managed by Certbot"). Nothing more to do
# by hand after that.
#
# Proxies to the oauth2-proxy sidecar (127.0.0.1:4182), NOT directly to
# jobs-board (127.0.0.1:8900) -- the whole point is that nothing reaches
# the board without passing through Google OAuth first.

server {
    listen 80;
    server_name jobs.ahfl.in;

    location / {
        proxy_pass http://127.0.0.1:4182;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 240s: matches oauth2-proxy's --upstream-timeout and the
        # free-whisper gateway's own documented worst case (whisper
        # ~90s + AssemblyAI fallback ~120s). A shorter timeout here
        # would 504 a slow-but-succeeding dictation request.
        proxy_read_timeout 240s;
        proxy_send_timeout 60s;
        client_max_body_size 20m;
    }
}
