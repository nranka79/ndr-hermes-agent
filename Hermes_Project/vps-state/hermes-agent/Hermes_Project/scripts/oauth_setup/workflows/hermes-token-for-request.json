{
  "name": "hermes-token-for-request",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hermes-token-for-request",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "hermes-token-for-request"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst telegram_id = String(body.telegram_id || '').trim();\nif (!telegram_id) {\n  throw new Error('hermes-token-for-request: missing telegram_id in request body');\n}\nreturn [{ json: { telegram_id } }];"
      },
      "id": "node-extract",
      "name": "Extract telegram_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT refresh_token, access_token, token_expiry AT TIME ZONE 'UTC' AS token_expiry_utc FROM gws_oauth_tokens WHERE telegram_id = $1",
        "additionalFields": {
          "queryParams": "={{ [$json.telegram_id] }}"
        }
      },
      "id": "node-fetch-token",
      "name": "Fetch Token from DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [680, 300],
      "credentials": {
        "postgres": {
          "name": "Hermes Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-row-exists",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-row",
      "name": "Row Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build OAuth URL for first-time user\nconst telegram_id = $('Extract telegram_id').first().json.telegram_id;\nconst clientId = $env.HERMES_GOOGLE_CLIENT_ID;\nconst redirectUri = encodeURIComponent($env.HERMES_GOOGLE_REDIRECT_URI);\nconst scope = encodeURIComponent($env.HERMES_OAUTH_SCOPES);\n\nconst authUrl = `https://accounts.google.com/o/oauth2/v2/auth` +\n  `?client_id=${clientId}` +\n  `&redirect_uri=${redirectUri}` +\n  `&response_type=code` +\n  `&scope=${scope}` +\n  `&access_type=offline` +\n  `&prompt=consent` +\n  `&state=${encodeURIComponent(telegram_id)}`;\n\nreturn [{ json: { needs_auth: true, auth_url: authUrl } }];"
      },
      "id": "node-build-auth-url",
      "name": "Build Auth URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 480]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-respond-needs-auth",
      "name": "Respond Needs Auth",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 480]
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst now = Date.now();\nconst expiry = row.token_expiry_utc ? new Date(row.token_expiry_utc).getTime() : 0;\nconst isValid = expiry > now + 60000;\nreturn [{ json: {\n  refresh_token: row.refresh_token,\n  access_token: row.access_token,\n  is_valid: isValid\n} }];"
      },
      "id": "node-check-expiry",
      "name": "Check Token Expiry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $json.is_valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-valid",
      "name": "Token Still Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ access_token: $json.access_token }) }}",
        "options": {}
      },
      "id": "node-respond-valid",
      "name": "Respond Valid Token",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "grant_type", "value": "refresh_token" },
            { "name": "refresh_token", "value": "={{ $('Check Token Expiry').first().json.refresh_token }}" },
            { "name": "client_id", "value": "={{ $env.HERMES_GOOGLE_CLIENT_ID }}" },
            { "name": "client_secret", "value": "={{ $env.HERMES_GOOGLE_CLIENT_SECRET }}" }
          ]
        },
        "options": {}
      },
      "id": "node-refresh",
      "name": "Refresh Access Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 420]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE gws_oauth_tokens SET access_token = $1, token_expiry = NOW() + ($2 || ' seconds')::interval, updated_at = NOW() WHERE telegram_id = $3",
        "additionalFields": {
          "queryParams": "={{ [$json.access_token, String($json.expires_in || 3599), $('Extract telegram_id').first().json.telegram_id] }}"
        }
      },
      "id": "node-update-db",
      "name": "Store Refreshed Token",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1780, 420],
      "credentials": {
        "postgres": {
          "name": "Hermes Postgres"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ access_token: $('Refresh Access Token').first().json.access_token }) }}",
        "options": {}
      },
      "id": "node-respond-refreshed",
      "name": "Respond Refreshed Token",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2000, 420]
    }
  ],
