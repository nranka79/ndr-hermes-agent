{
  "name": "hermes-oauth-init",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hermes-oauth-init",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "hermes-oauth-init"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst telegram_id = String(body.telegram_id || '').trim();\nconst telegram_username = String(body.telegram_username || '').trim();\nif (!telegram_id) throw new Error('Missing telegram_id in request body');\nreturn [{ json: { telegram_id, telegram_username } }];"
      },
      "id": "node-extract",
      "name": "Extract Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT telegram_id FROM gws_oauth_tokens WHERE telegram_id = $1",
        "additionalFields": {
          "queryParams": "={{ [$json.telegram_id] }}"
        }
      },
      "id": "node-check-db",
      "name": "Check DB for Existing Token",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [680, 300],
      "credentials": {
        "postgres": {
          "name": "Hermes Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-exists",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-exists",
      "name": "Token Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"needs_auth\": false }",
        "options": {}
      },
      "id": "node-respond-ok",
      "name": "Respond Already Authorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "jsCode": "const extract = $('Extract Body').first().json;\nconst telegram_id = extract.telegram_id;\nconst clientId = $env.HERMES_GOOGLE_CLIENT_ID;\nconst redirectUri = encodeURIComponent($env.HERMES_GOOGLE_REDIRECT_URI);\nconst scope = encodeURIComponent($env.HERMES_OAUTH_SCOPES);\n\nconst authUrl = `https://accounts.google.com/o/oauth2/v2/auth` +\n  `?client_id=${clientId}` +\n  `&redirect_uri=${redirectUri}` +\n  `&response_type=code` +\n  `&scope=${scope}` +\n  `&access_type=offline` +\n  `&prompt=consent` +\n  `&state=${encodeURIComponent(telegram_id)}`;\n\nreturn [{ json: { needs_auth: true, auth_url: authUrl } }];"
      },
      "id": "node-build-url",
      "name": "Build OAuth URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-respond-auth",
      "name": "Respond Needs Auth",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Extract Body", "type": "main", "index": 0 }]]
    },
    "Extract Body": {
      "main": [[{ "node": "Check DB for Existing Token", "type": "main", "index": 0 }]]
    },
    "Check DB for Existing Token": {
      "main": [[{ "node": "Token Exists?", "type": "main", "index": 0 }]]
    },
    "Token Exists?": {
      "main": [
        [{ "node": "Respond Already Authorized", "type": "main", "index": 0 }],
        [{ "node": "Build OAuth URL", "type": "main", "index": 0 }]
      ]
    },
    "Build OAuth URL": {
      "main": [[{ "node": "Respond Needs Auth", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
